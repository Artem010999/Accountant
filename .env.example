# ---- Frontend (Vite: только VITE_* попадают в браузер) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_PIPELINE_URL=http://localhost:8080/pipeline
VITE_SUPPORT_ENDPOINT=http://localhost:8080/support

# ---- Backend: Postgres / Supabase (только сервер, не во фронтенд) ----
SUPABASE_DB_URL=postgres://postgres:postgres@localhost:54322/postgres
DEV_SEED=0

# ---- Backend: pipeline-api ----
PORT=8080
PIPELINE_SHARED_SECRET=change-me
KB_MANIFEST_PATH=

# ---- Backend: обращения в поддержку (POST /support) ----
# Получатель писем. По умолчанию test@test.com.
SUPPORT_EMAIL=test@test.com
# Единственный origin фронтенда, для которого открыт CORS на /support.
SUPPORT_ALLOWED_ORIGIN=http://localhost:5173
# Почта: без SMTP_HOST письма пишутся JSON-файлами в backend/pipeline-api/outbox/ (или в OUTBOX_DIR).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
OUTBOX_DIR=

# ---- Backend: LLM (3 независимых OpenAI-совместимых канала) ----

# 1. Канал OpenCode Go (DeepSeek — сборка блоков, тех. подход и аналоги, чат-консультант)
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4.1-flash

# 2. Канал Kimi Code (Kimi — первичный аудит и точечный ре-аудит)
KIMI_BASE_URL=https://api.kimi.ai/coding/v1
KIMI_API_KEY=
KIMI_MODEL=kimi-k3

# 3. Канал Эмбеддингов AITunnel (Qwen3 Embedding 8B — анти-фрод якорь и RAG)
EMBEDDING_BASE_URL=https://api.aitunnel.ru/v1/
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding-8b
EMBEDDING_DIMENSIONS=4096

# Legacy OpenAI fallbacks (обратная совместимость)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=qwen3-embedding-8b

# ---- Backend: parser-service / объектное хранилище (приватный бакет) ----
PARSER_URL=http://localhost:8000
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
