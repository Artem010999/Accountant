# ШАБЛОН .env. Копируйте в .env и заполните. Для продакшена это же содержимое кладётся в секрет ENV_FILE в GitHub.
# Знак $ в значениях экранируется как $$ (нужно для bcrypt-хеша админки).
# Комментарии — отдельными строками: в значениях их не ставим.

# ---- База данных (Postgres в контейнере) ----
# Пароль генерируется: openssl rand -hex 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=postgres
# Порт на хосте для локальной отладки; на проде не публикуется.
POSTGRES_HOST_PORT=54322
# Локально 1 (тестовые данные), на проде 0.
DEV_SEED=0

# ---- Порты на хосте (локально; на проде не публикуются) ----
PARSER_HOST_PORT=8000
PIPELINE_HOST_PORT=8080
FRONTEND_HOST_PORT=8081
STUB_LLM_HOST_PORT=8090

# ---- Вход по коду из письма ----
# Генерируется: openssl rand -hex 32
AUTH_SECRET=<openssl rand -hex 32>
# true на проде (https); false только для локального http.
AUTH_COOKIE_SECURE=true
# Пусто: вход по сессии, а не по общему секрету.
PIPELINE_SHARED_SECRET=

# ---- LLM: OpenAI-совместимый канал ----
# Обязателен: сервер не стартует без OPENAI_API_KEY.
OPENAI_API_KEY=<ключ>
# Адрес API. Локально с заглушкой: http://stub-llm:8090/v1
OPENAI_BASE_URL=<адрес API>
OPENAI_CHAT_MODEL=<модель чата>
OPENAI_EMBEDDING_MODEL=<модель эмбеддингов>

# ---- LLM: каналы DeepSeek / Kimi / эмбеддинги ----
DEEPSEEK_BASE_URL=<адрес>
DEEPSEEK_API_KEY=<ключ>
DEEPSEEK_MODEL=<модель>
KIMI_BASE_URL=<адрес>
KIMI_API_KEY=<ключ>
KIMI_MODEL=<модель>
EMBEDDING_BASE_URL=<адрес>
EMBEDDING_API_KEY=<ключ>
EMBEDDING_MODEL=<модель>
EMBEDDING_DIMENSIONS=4096

# ---- Почта (Yandex Postbox, SMTP) ----
SMTP_HOST=postbox.cloud.yandex.net
SMTP_PORT=587
SMTP_USER=<ID API-ключа>
SMTP_PASS=<секрет API-ключа>
MAIL_FROM=noreply@bukha.ru

# ---- Поддержка (POST /support) ----
SUPPORT_EMAIL=<адрес для обращений>
SUPPORT_ALLOWED_ORIGIN=https://bukha.ru

# ---- Фронтенд (встраивается при сборке) ----
VITE_PIPELINE_URL=/pipeline
VITE_SUPPORT_ENDPOINT=/support
VITE_AUTH_ENDPOINT=/auth
VITE_CHAT_ENDPOINT=/chat
# Supabase не используется: оставить пустыми.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Домен, SSL и админка (профиль prod) ----
SITE_DOMAIN=bukha.ru
# Почта для уведомлений Let's Encrypt.
ACME_EMAIL=<почта>
ADMIN_BASIC_USER=<логин для /admin-panel>
# Хеш: docker run --rm caddy:2-alpine caddy hash-password ; знаки $ записать как $$
ADMIN_BASIC_PASSWORD_HASH=<хеш bcrypt>

# ---- Ресурсы контейнеров (обычный режим; суммарно ≤ 3 ядра и ≤ 6 GiB) ----
CPU_POSTGRES=1.0
MEM_POSTGRES=1536M
CPU_DBMIGRATE=0.5
MEM_DBMIGRATE=1024M
CPU_PARSER=0.75
MEM_PARSER=1536M
CPU_PIPELINE=1.0
MEM_PIPELINE=1024M
CPU_FRONTEND=0.25
MEM_FRONTEND=128M
CPU_CADDY=0.1
MEM_CADDY=128M
# Куча Node в МБ; должна быть меньше MEM_PIPELINE.
NODE_HEAP_MB=768

# ---- Батч / off-peak (docker-compose.offpeak.yml; суммарно ≤ 5 ядер и ≤ 8 GiB) ----
OFFPEAK_CPU_POSTGRES=1.5
OFFPEAK_MEM_POSTGRES=3072M
OFFPEAK_CPU_PARSER=1.75
OFFPEAK_MEM_PARSER=2560M
OFFPEAK_CPU_PIPELINE=1.5
OFFPEAK_MEM_PIPELINE=2048M
OFFPEAK_NODE_HEAP_MB=1536

# ---- Логи контейнеров (ротация) ----
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ---- Образы: проставляет CI при деплое, локально не нужны ----
# IMAGE_PIPELINE=
# IMAGE_PARSER=
# IMAGE_FRONTEND=

# ---- Заглушка LLM для локального запуска ----
# Только локально, на проде не нужно.
